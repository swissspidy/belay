  "description": "Opt-in traces of Belay runs, sent to your own sink, and the labeled datasets built from them.",
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "homepage": "https://github.com/swissspidy/belay/tree/main/packages/trace#readme",
