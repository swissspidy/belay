{
  "name": "@swissspidy/belay-tune",
  "version": "0.1.1",
  "description": "Belay Tune: score a task's local side on recorded traces (local share at a target accuracy), in a real Chrome.",
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "homepage": "https://github.com/swissspidy/belay/tree/main/packages/tune#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/belay.git",
    "directory": "packages/tune"
  },
  "bugs": {
    "url": "https://github.com/swissspidy/belay/issues"
  },
  "keywords": [
    "ai",
    "on-device",
    "cascade",
    "evaluation",
    "tuning",
    "prompt-optimization"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/local-config.d.ts",
      "import": "./dist/local-config.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b --force"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@swissspidy/belay-calibrate": "^0.1.1",
    "@swissspidy/belay-core": "^0.1.1",
    "@swissspidy/belay-trace": "^0.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
