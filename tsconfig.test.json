{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@swissspidy/belay-core": ["./packages/core/src/index.ts"],
      "@swissspidy/belay-web": ["./packages/web/src/index.ts"],
      "@swissspidy/belay-learn": ["./packages/learn/src/index.ts"],
      "@swissspidy/belay-trace": ["./packages/trace/src/index.ts"],
      "@swissspidy/belay-trace/node": ["./packages/trace/src/node/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"]
}
